PORT=5000
JWT_SECRET=your_jwt_secret_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# StyleMate LLM Provider: 'gemini' (default cloud model) or 'local' (self-hosted open-source model)
LLM_PROVIDER=gemini
LOCAL_LLM_URL=http://localhost:5001

# SerpAPI for Smart Shopping Google Shopping integration
SERPAPI_KEY=your_serpapi_key_here
